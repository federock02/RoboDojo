#usda 1.0
( defaultPrim = "LTool" )
def Xform "LTool" (prepend apiSchemas = ["PhysxContactReportAPI"]) {
    float physxContactReport:threshold = 0
    def Mesh "LongArm" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    ) {
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.26, -0.5, -0.5), (0.26, -0.5, -0.333333), (0.26, 0.5, -0.5), (0.26, 0.5, -0.333333), (0.46, -0.5, -0.5), (0.46, -0.5, -0.333333), (0.46, 0.5, -0.5), (0.46, 0.5, -0.333333)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        color3f[] primvars:displayColor = [(0.24, 0.26, 0.29)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </LTool/Looks/ToolMaterial>
    }
    def Mesh "Crossbar" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    ) {
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(-0.5, 0.425, -0.5), (-0.5, 0.425, -0.333333), (-0.5, 0.5, -0.5), (-0.5, 0.5, -0.333333), (0.5, 0.425, -0.5), (0.5, 0.425, -0.333333), (0.5, 0.5, -0.5), (0.5, 0.5, -0.333333)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        color3f[] primvars:displayColor = [(0.24, 0.26, 0.29)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </LTool/Looks/ToolMaterial>
    }
    def Mesh "Handle" (
        prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
    ) {
        uniform token physics:approximation = "convexHull"
        point3f[] points = [(0.245, -0.5, -0.333333), (0.245, -0.5, 0.5), (0.245, -0.4, -0.333333), (0.245, -0.4, 0.5), (0.475, -0.5, -0.333333), (0.475, -0.5, 0.5), (0.475, -0.4, -0.333333), (0.475, -0.4, 0.5)]
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        color3f[] primvars:displayColor = [(0.95, 0.45, 0.1)]
        uniform token subdivisionScheme = "none"
        rel material:binding = </LTool/Looks/ToolMaterial>
    }
    def Scope "Looks" {
        def Material "ToolMaterial" {
            token outputs:surface.connect = </LTool/Looks/ToolMaterial/PreviewSurface.outputs:surface>
            def Shader "PrimvarReader" {
                uniform token info:id = "UsdPrimvarReader_float3"
                token inputs:varname = "displayColor"
                float3 outputs:result
            }
            def Shader "PreviewSurface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </LTool/Looks/ToolMaterial/PrimvarReader.outputs:result>
                float inputs:roughness = 0.55
                float inputs:metallic = 0.1
                token outputs:surface
            }
        }
    }
}
